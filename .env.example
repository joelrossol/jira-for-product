# Joel's Jira Dashboard configuration.
#
# 1. Copy this file to .env.local:    cp .env.example .env.local
# 2. Fill in the three values below.
# 3. Restart the app (npm run dev).
#
# .env.local is git-ignored, so your token stays on your machine. Never put a
# real token in this file. Leave everything blank to run on built-in demo data.

# Your Jira Cloud site address, just the site, e.g. https://your-team.atlassian.net
JIRA_BASE_URL=
# The email address you sign in to Atlassian with
JIRA_EMAIL=
# An API token from https://id.atlassian.com/manage-profile/security/api-tokens
# (use "Create API token", the classic kind, not one with scopes)
JIRA_API_TOKEN=

# Optional settings. Uncomment a line to change it.
# Which tickets count as "yours" (JQL, no ORDER BY):
# JIRA_SCOPE_JQL=assignee = currentUser() OR reporter = currentUser()
# Limit everything to these project keys:
# JIRA_PROJECTS=WEB,APP
# Open tickets with no update for this many days count as stale:
# JIRA_STALE_DAYS=14
# Status names shown as Kanban columns, left to right:
# JIRA_KANBAN_COLUMNS=Backlog,Ready,Ready for Dev
# Statuses that count as "completed" in the dashboard chart:
# JIRA_DONE_STATUSES=Done,Ready for Prod
# Statuses shown in the "Ready for acceptance" tiles:
# JIRA_ACCEPTANCE_STATUSES=Ready for Acceptance
# Cap on issues fetched for dashboard stats:
# JIRA_MAX_ISSUES=1000
# Force demo data for everyone, even with credentials set:
# JIRA_DEMO=1
